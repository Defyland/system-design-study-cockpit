<% content_for :title, "English C2 Arcade" %>

<style>
  .english-arcade { --arcade-ink: #17252a; --arcade-muted: #5e6c70; --arcade-line: #ccd8d4; --arcade-panel: #fffdf7; --arcade-accent: #176b70; --arcade-accent-soft: #e4f1ed; --arcade-warn: #fff2c2; --arcade-danger: #8d352e; color: var(--arcade-ink); display: grid; gap: 18px; }
  .english-arcade * { box-sizing: border-box; }
  html, body { max-width: 100vw; overflow-x: hidden; }
  .arcade-hero, .arcade-panel { background: var(--arcade-panel); border: 1px solid var(--arcade-line); border-radius: 12px; padding: clamp(16px, 3vw, 28px); min-width: 0; }
  .arcade-hero { background: linear-gradient(135deg, #e5f2ee, #fff9df); border-color: #b9d0c7; }
  .arcade-kicker { color: var(--arcade-accent); font-size: .76rem; font-weight: 800; letter-spacing: .08em; }
  .arcade-hero h1, .arcade-panel h2, .arcade-panel h3 { line-height: 1.2; margin: 6px 0 10px; }
  .arcade-muted { color: var(--arcade-muted); }
  .arcade-grid { display: grid; gap: 18px; grid-template-columns: minmax(0, 1.35fr) minmax(250px, .65fr); align-items: start; }
  .arcade-targets { display: grid; gap: 8px; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); }
  .arcade-target { position: relative; }
  .arcade-target input { accent-color: var(--arcade-accent); cursor: pointer; height: 18px; left: 10px; opacity: 1; position: absolute; top: 10px; width: 18px; z-index: 2; }
  .arcade-target label { background: #f6faf7; border: 1px solid var(--arcade-line); border-radius: 9px; cursor: pointer; display: grid; gap: 3px; min-height: 64px; padding: 10px 10px 10px 38px; }
  .arcade-target input:checked + label { background: var(--arcade-accent-soft); border-color: var(--arcade-accent); box-shadow: 0 0 0 2px #bcded4; }
  .arcade-target input:focus-visible + label, .arcade-choice:focus-visible, .arcade-button:focus-visible, .arcade-text:focus-visible { outline: 3px solid #f0b429; outline-offset: 2px; }
  .arcade-target small { color: var(--arcade-muted); font-size: .75rem; }
  .arcade-modes, .arcade-actions, .arcade-choice-list, .arcade-stats, .arcade-history { display: grid; gap: 8px; }
  .arcade-modes { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 14px; }
  .arcade-mode { align-items: center; background: #f6faf7; border: 1px solid var(--arcade-line); border-radius: 8px; display: flex; gap: 8px; min-height: 44px; padding: 9px; }
  .arcade-button { background: var(--arcade-accent); border: 0; border-radius: 7px; color: #fff; cursor: pointer; display: inline-block; font: inherit; font-weight: 800; min-height: 44px; padding: 10px 14px; text-decoration: none; }
  .arcade-button.secondary { background: #dce9e5; color: #174f53; }
  .arcade-button.ghost { background: transparent; border: 1px solid var(--arcade-line); color: var(--arcade-ink); }
  .arcade-button[disabled] { cursor: not-allowed; opacity: .45; }
  .arcade-session-bar { align-items: center; display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; }
  .arcade-session-meta, .arcade-stats { display: flex; flex-wrap: wrap; gap: 8px; }
  .arcade-pill { background: var(--arcade-accent-soft); border-radius: 999px; color: #1b5d5c; font-size: .8rem; font-weight: 800; padding: 4px 9px; }
  .arcade-pill.warn { background: var(--arcade-warn); color: #6c5315; }
  .arcade-timer { font-variant-numeric: tabular-nums; font-weight: 900; min-width: 4.8rem; text-align: center; }
  .arcade-question { display: grid; gap: 14px; }
  .arcade-question h2 { font-size: clamp(1.2rem, 2.2vw, 1.6rem); }
  .arcade-context { background: #f7f4ed; border-left: 4px solid #bbcfca; padding: 10px 12px; }
  .arcade-choice-list { border: 0; margin: 0; padding: 0; }
  .arcade-choice { align-items: flex-start; background: #fbfcfa; border: 1px solid var(--arcade-line); border-radius: 8px; cursor: pointer; display: flex; gap: 10px; min-height: 44px; padding: 11px; }
  .arcade-choice:hover { border-color: var(--arcade-accent); }
  .arcade-choice input { flex: 0 0 auto; margin-top: 4px; }
  .arcade-choice .choice-key { color: var(--arcade-accent); font-weight: 900; min-width: 1.2rem; }
  .arcade-capture { display: grid; gap: 10px; grid-template-columns: minmax(0, 1fr) auto; }
  .arcade-capture label { display: grid; gap: 5px; }
  .arcade-text { border: 1px solid var(--arcade-line); border-radius: 7px; font: inherit; padding: 9px; width: 100%; }
  .arcade-actions { align-items: center; display: flex; flex-wrap: wrap; }
  .arcade-feedback { background: #f6faf7; border: 1px solid #a8cbbd; border-radius: 10px; display: grid; gap: 8px; padding: 14px; }
  .arcade-feedback.wrong { background: #fff5f0; border-color: #e0aaa1; }
  .arcade-answer { background: #fffdf7; border-left: 4px solid var(--arcade-accent); padding: 8px 10px; }
  .arcade-followups { display: flex; flex-wrap: wrap; gap: 8px; }
  .arcade-black-box { display: grid; gap: 10px; margin-top: 10px; }
  .arcade-black-box label { display: grid; gap: 5px; }
  .arcade-followups a { font-size: .9rem; }
  .arcade-history article { background: #f7f4ed; border: 1px solid var(--arcade-line); border-radius: 8px; padding: 10px 12px; }
  .arcade-history p { margin: 3px 0 0; }
  .arcade-progress { background: #f7f4ed; border: 1px solid var(--arcade-line); border-radius: 8px; margin-top: 10px; padding: 10px 12px; }
  .arcade-progress summary { cursor: pointer; font-weight: 800; min-height: 44px; padding: 10px 0; }
  .arcade-progress ol { display: grid; gap: 8px; margin: 8px 0 0; padding-left: 1.5rem; }
  .arcade-progress li { padding-left: 3px; }
  .arcade-progress li small { color: var(--arcade-muted); display: block; margin-top: 3px; }
  .arcade-evidence { display: grid; gap: 5px; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); margin-top: 8px; }
  .arcade-evidence span { background: #fffdf7; border: 1px solid var(--arcade-line); border-radius: 6px; padding: 6px 8px; }
  @media (max-width: 760px) { html, body { max-width: 100vw; overflow-x: hidden; width: 100%; } body { overflow-x: hidden; } .topbar { align-items: flex-start; flex-direction: column; gap: 10px; max-width: 100vw; min-width: 0; overflow: hidden; width: 100%; } .nav { gap: 8px 14px; justify-content: flex-start; max-width: 100%; min-width: 0; overflow: hidden; width: 100%; } .nav a { overflow-wrap: anywhere; } .page { max-width: 100vw; min-width: 0; overflow-x: hidden; padding: 24px 14px 40px; width: 100%; } .english-arcade { min-width: 0; width: 100%; max-width: 100%; overflow-x: hidden; } .arcade-grid { grid-template-columns: 1fr; } .arcade-modes, .arcade-capture { grid-template-columns: 1fr; } }
</style>

<section class="english-arcade" data-controller="english-arcade" data-english-arcade-duration-seconds-value="<%= @arcade_session&.duration_seconds || 0 %>" data-english-arcade-remaining-seconds-value="<%= @arcade_session&.remaining_seconds || 0 %>" data-english-arcade-active-value="<%= @arcade_session&.active? && !@arcade_session.expired? %>" data-english-arcade-guided-value="<%= @guided_experience %>" data-english-arcade-session-key-value="<%= @arcade_session&.id || "landing" %>" data-english-arcade-finish-url-value="<%= @arcade_session ? finish_english_arcade_path(session_id: @arcade_session.id) : "" %>">
  <header class="arcade-hero">
    <% if @guided_experience %>
      <span class="arcade-kicker">English C2 · guided study arcade</span>
    <% else %>
      <span class="arcade-kicker">English C2 · closed-book interview practice</span>
    <% end %>
    <h1>English C2 Arcade</h1>
    <% if @guided_experience %>
      <p class="arcade-muted">Study reviewed interview answers in a short, spoken rehearsal loop. The best answer is visible immediately; compare the authored alternatives, critical-thinking path, and evidence limits while the cards fall.</p>
      <p class="arcade-muted">Choose a card, say the answer aloud, and rate your readiness. Guided study never records an attempt, grades correctness, or changes diagnostic mastery.</p>
    <% else %>
      <p class="arcade-muted">Choose one target, type an answer before feedback appears, then turn each miss into a Black Box post-mortem and a scheduled reattempt. This is C2-calibrated typed interview practice, not a C2 certificate or a promise in 30 days.</p>
      <p class="arcade-muted">This typed practice does not record, transcribe, or score audio. Use the documented external-platform handoff for assessment outside this product.</p>
    <% end %>
  </header>

  <section class="arcade-panel" aria-labelledby="arcade-launcher-title">
    <div class="arcade-session-bar">
      <div>
        <h2 id="arcade-launcher-title">Choose your interview target</h2>
        <p class="arcade-muted">Your last target is remembered in this browser and on the session record.</p>
      </div>
      <% if @arcade_session %>
        <span class="arcade-pill"><%= @arcade_session.status.humanize %></span>
      <% end %>
    </div>

    <%= form_with url: english_arcade_sessions_path, scope: :english_arcade_session, local: true do |form| %>
      <div class="arcade-targets" role="radiogroup" aria-label="Interview target">
        <% @targets.each do |key, target| %>
          <div class="arcade-target">
            <%= form.radio_button :target, key, checked: key == @selected_target, id: "english-arcade-target-#{key}" %>
            <%= form.label "target_#{key}", for: "english-arcade-target-#{key}" do %>
              <strong><%= target[:label] %></strong>
              <small><%= target[:focus] %></small>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="arcade-modes" role="radiogroup" aria-label="Session length">
        <% @modes.each do |key, mode| %>
          <label class="arcade-mode">
            <%= form.radio_button :mode, key, checked: key == @selected_mode %>
            <span><strong><%= mode[:label] %></strong><br><small class="arcade-muted"><%= mode[:duration_seconds] / 60 %> minutes · <%= @guided_experience ? "guided cards and spoken rehearsal" : "feedback after submit" %></small></span>
          </label>
        <% end %>
      </div>

      <div class="arcade-actions">
        <%= button_tag(@arcade_session ? "Start another guided session" : "Start guided study", type: "submit", name: "english_arcade_session[experience]", value: "guided", class: "arcade-button") %>
        <%= button_tag("Start closed-book session", type: "submit", name: "english_arcade_session[experience]", value: "assessment", class: "arcade-button ghost") %>
        <% if @guided_experience %>
          <span class="arcade-muted" aria-live="polite">Guided self-ratings stay in this browser.</span>
        <% else %>
          <span class="arcade-muted" aria-live="polite"><%= @schedule_summary[:due] %> cards due · <%= @schedule_summary[:mastered] %> in box 5</span>
        <% end %>
      </div>
      <% if @guided_experience %>
        <p class="arcade-muted">Guided progress is saved only in this browser. It does not create attempts, grades, or diagnostic mastery records.</p>
      <% else %>
        <p class="arcade-muted">Program day <%= @progress_30_days[:program_day] %> · <%= @progress_30_days[:practice_days] %> practice days · <%= @progress_30_days[:attempts] %> attempts · <%= @progress_30_days[:correct] %> revealed correct · <%= @progress_30_days[:black_box] %> completed Black Box post-mortems (<%= @progress_30_days[:black_box_required] %> required).</p>
      <% end %>
      <div class="arcade-actions">
        <%= link_to "Export 30-day progress JSON", english_arcade_path(format: :json, session_id: @arcade_session&.id), class: "arcade-button ghost", aria: { label: "Export the 30-day progress and practice plan as JSON" } %>
      </div>
    <% end %>
      <% if @guided_experience %>
        <% if @arcade_session %>
          <div class="arcade-progress">
            <strong>Guided deck</strong>
            <p class="arcade-muted">Read the authored cards below, rehearse aloud, and use the local self-rating controls when you are ready.</p>
          </div>
        <% else %>
          <details class="arcade-progress">
            <summary>How guided study works</summary>
            <p class="arcade-muted">Choose a target and a 10-, 30-, or 45-minute deck. The authored answer and explanations stay visible while each falling card pauses at the reading line. Your self-rating and position stay in this browser; the guided loop does not create diagnostic attempts.</p>
          </details>
        <% end %>
      <% else %>
      <details class="arcade-progress">
        <summary>Open the 30-day practice plan</summary>
        <p class="arcade-muted">Every day has a target selector, timed evidence, due SRS review, reattempt, follow-up, and compression. Gates pass only on typed evidence; they do not certify CEFR level.</p>
        <ol>
          <% @thirty_day_plan.each do |day| %>
            <li>
              <strong>Day <%= day.fetch("day") %>:</strong> <%= day.fetch("outcome") %>
              <small><strong><%= day.fetch("timebox_minutes") %> minutes</strong> · targets: <%= day.dig("assignment", "targets").join(", ") %> · <%= day.dig("assignment", "selector") %></small>
              <div class="arcade-actions">
                <% day.dig("assignment", "item_ids").each do |item_id| %>
                  <%= button_to "Launch #{item_id}", english_arcade_sessions_path, params: { english_arcade_session: { target: EnglishArcadeCurriculum.target_for(item_id), mode: "daily", card_key: item_id } }, class: "arcade-button ghost" %>
                <% end %>
              </div>
              <% if day.fetch("spaced_reattempts").any? %>
                <small><strong>Scheduled reattempts:</strong> <%= day.fetch("spaced_reattempts").map { |entry| "#{entry.fetch("item_id")} (day #{entry.fetch("original_day")}, #{entry.fetch("attempt_kind")})" }.join(" · ") %></small>
                <div class="arcade-actions">
                  <% day.fetch("spaced_reattempts").each do |entry| %>
                    <%= button_to "Launch #{entry.fetch("attempt_kind")} #{entry.fetch("item_id")}", english_arcade_sessions_path, params: { english_arcade_session: { target: EnglishArcadeCurriculum.target_for(entry.fetch("item_id")), mode: "daily", card_key: entry.fetch("item_id"), exercise: entry.fetch("attempt_kind") } }, class: "arcade-button ghost" %>
                  <% end %>
                </div>
              <% end %>
              <% if day.fetch("mocks").any? %>
                <small><strong>Timed mocks:</strong> <%= day.fetch("mocks").map { |mock| "#{mock.fetch("target")} #{mock.fetch("duration_minutes")}m — #{mock.fetch("breakdown").map { |label, minutes| "#{label} #{minutes}m" }.join(", ")}" }.join(" · ") %></small>
                <% day.fetch("mocks").each do |mock| %><small><strong><%= mock.fetch("target") %> constraints:</strong> <%= mock.fetch("constraints", []).join(" · ").presence || "none" %></small><% end %>
                <div class="arcade-actions">
                <% day.fetch("mocks").each do |mock| %>
                    <%= button_to "Launch #{mock.fetch("id")}", english_arcade_sessions_path, params: { english_arcade_session: { mock_id: mock.fetch("id"), target: mock.fetch("target"), mode: mock.fetch("mode"), card_key: mock.fetch("required_card_keys").first, exercise: "initial" } }, class: "arcade-button ghost" %>
                  <% end %>
                </div>
              <% end %>
              <% if day["gate"] %>
                <% current_gate = @progress_30_days.fetch(:gates, []).find { |gate| gate.fetch("day") == day.fetch("day") } %>
                <small><strong>Gate thresholds:</strong> <%= day.dig("gate", "thresholds").map { |key, value| "#{key}=#{value}" }.join(" · ") %></small>
                <small><strong>Pass:</strong> <%= day.dig("gate", "accept") %> <strong>Fail:</strong> <%= day.dig("gate", "fail") %> <strong>Recovery:</strong> <%= day.dig("gate", "recovery", "assignment") %>, Black Box, retest in <%= day.dig("gate", "recovery", "retest_after_days") %> days.</small>
                <% if current_gate %><small><strong>Current:</strong> <%= current_gate.fetch("status") %> — <%= current_gate.fetch("reasons").join("; ").presence || "threshold met" %></small><% end %>
              <% end %>
            </li>
          <% end %>
        </ol>
      </details>
      <% end %>
  </section>

  <% if @arcade_session %>
    <% if @guided_experience %>
      <%= render "guided" %>
    <% else %>
    <div class="arcade-grid">
      <div class="arcade-panel arcade-question">
        <div class="arcade-session-bar">
          <div>
            <span class="arcade-kicker"><%= @plan.mode_label %></span>
            <h2><%= @plan.target_label %></h2>
          </div>
          <div class="arcade-session-meta">
            <span class="arcade-pill">Score <%= @arcade_session.score %></span>
            <span class="arcade-pill">Answered <%= @arcade_session.question_count %></span>
            <span class="arcade-pill arcade-timer" data-english-arcade-target="countdown" aria-live="polite">--:--</span>
          </div>
        </div>

        <% if @mock_phase_payload %>
          <section class="arcade-feedback" aria-labelledby="mock-phase-title">
            <% if @mock_phase %>
              <span class="arcade-kicker">Mock phase <%= @mock_phase_payload.fetch("phase_index") + 1 %> of <%= @mock_phase_payload.fetch("phase_count") %></span>
              <h2 id="mock-phase-title"><%= @mock_phase.fetch("label") %></h2>
              <p class="arcade-context"><%= @mock_phase.fetch("brief") %></p>
              <p class="arcade-muted"><strong>Interviewer timebox:</strong> <%= @mock_phase.fetch("minutes") %> minutes · <strong>Required artifact:</strong> <%= @mock_phase.fetch("artifact_prompt") %></p>
              <%= form_with url: english_arcade_attempts_path(session_id: @arcade_session.id), scope: :english_arcade_attempt, local: true do |form| %>
                <%= form.hidden_field :phase, value: "mock_phase" %>
                <%= form.hidden_field :phase_id, value: @mock_phase.fetch("id") %>
                <%= form.label :phase_artifact, "Typed phase artifact" %>
                <%= form.text_area :phase_artifact, rows: 5, class: "arcade-text", required: true, minlength: @mock_phase.fetch("minimum_chars"), placeholder: "Write the artifact the interviewer requested…" %>
                <%= form.submit "Complete phase", class: "arcade-button" %>
              <% end %>
            <% else %>
              <span class="arcade-kicker">All mock phases complete</span>
              <p id="mock-phase-title" class="arcade-context">All curriculum-owned phases are complete. Finish the mock after the required card has been revealed and the timed floor has elapsed.</p>
            <% end %>
          </section>
        <% end %>

        <% if @feedback_attempt && @feedback %>
          <section class="arcade-feedback <%= @feedback_attempt.correct? ? "correct" : "wrong" %>" data-english-arcade-target="feedback" aria-live="assertive" tabindex="-1">
            <strong><%= @feedback_attempt.correct? ? "Good call — now make it precise." : "Black Box: the miss is evidence, not a verdict." %></strong>
            <% EnglishArcadeController::FEEDBACK_AXES.each do |axis| %>
              <p><strong><%= axis.humanize %>:</strong> <%= @feedback.fetch(axis) %></p>
            <% end %>
            <div class="arcade-answer"><strong>Answer after attempt:</strong> <%= @feedback.fetch("answer") %></div>
            <% revealed_sources = Array(@feedback["sources"].presence || @feedback_card&.sources) %>
            <% if revealed_sources.any? %>
              <details class="arcade-progress">
                <summary>Evidence sources (revealed)</summary>
                <ul>
                  <% revealed_sources.each do |source| %>
                    <li>
                      <% if source.is_a?(Hash) %>
                        <strong><%= source["repo"] %> / <%= source["path"] %></strong>
                        <% if source["note"].present? %><span class="arcade-muted"> — <%= source["note"] %></span><% end %>
                      <% else %>
                        <strong><%= source %></strong>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </details>
            <% end %>
            <% revealed_provenance = @feedback["provenance"].is_a?(Hash) ? @feedback["provenance"] : (@feedback_card&.provenance || {}) %>
            <% if revealed_provenance.any? %>
              <details class="arcade-progress">
                <summary>Provenance and interview-safe boundary (revealed)</summary>
                <% if revealed_provenance["project"].present? %><p><strong>Project:</strong> <%= revealed_provenance["project"] %></p><% end %>
                <% if revealed_provenance["repository"].present? %><p><strong>Repository:</strong> <%= revealed_provenance["repository"] %></p><% end %>
                <% if revealed_provenance["safe_interview_version"].present? %><p><strong>Safe interview version:</strong> <%= revealed_provenance["safe_interview_version"] %></p><% end %>
                <% confidentiality = revealed_provenance["confidentiality"] %>
                <% if confidentiality.is_a?(Hash) %>
                  <p><strong>Confidentiality:</strong> <%= confidentiality["level"] %><% if confidentiality["note"].present? %> — <%= confidentiality["note"] %><% end %></p>
                <% end %>
                <% if Array(revealed_provenance["verified_claims"]).any? %>
                  <p><strong>Verified claims:</strong></p>
                  <ul><% Array(revealed_provenance["verified_claims"]).each do |claim| %><li><%= claim %></li><% end %></ul>
                <% end %>
                <% if Array(revealed_provenance["confirmation_required"]).any? %>
                  <p><strong>Confirm before claiming:</strong></p>
                  <ul><% Array(revealed_provenance["confirmation_required"]).each do |gap| %><li><%= gap %></li><% end %></ul>
                <% end %>
                <% if Array(revealed_provenance["files"]).any? %>
                  <p><strong>Inspectable evidence:</strong></p>
                  <ul>
                    <% Array(revealed_provenance["files"]).each do |file| %>
                      <% next unless file.is_a?(Hash) %>
                      <li><%= file["path"] %> @ <%= file["commit"] %> — <%= file["claim"] %></li>
                    <% end %>
                  </ul>
                <% end %>
              </details>
            <% end %>
            <% if @feedback_card&.recall&.fetch("active_recall_cue", nil).present? %>
              <p class="arcade-muted"><strong>Recall cue:</strong> <%= @feedback_card.recall.fetch("active_recall_cue") %></p>
            <% end %>
            <% if @feedback["selected"].present? %><p class="arcade-muted">You chose: <%= @feedback.fetch("selected") %></p><% end %>
            <% if @feedback_attempt.correct? || @feedback_attempt.black_box_complete? %>
              <div class="arcade-followups">
              <% if @feedback_card %>
                <% { "Retry this question" => ["retry", "secondary"], "Rephrase for a stakeholder" => ["rephrase", "ghost"], "Add an extension" => ["extension", "ghost"], "Answer interviewer follow-up" => ["follow_up", "ghost"], "Compress the answer" => ["compression", "ghost"] }.each do |label, (exercise, style)| %>
                  <%= button_to label, english_arcade_sessions_path, params: { english_arcade_session: { target: @arcade_session.target, mode: @arcade_session.mode, card_key: @feedback_card.key, exercise: exercise } }, class: "arcade-button #{style}" %>
                <% end %>
                <%= link_to "Continue to next card", english_arcade_path(session_id: @arcade_session.id), class: "arcade-button ghost" %>
              <% end %>
              </div>
            <% else %>
              <p class="arcade-muted">Complete the five Black Box fields before scheduling or continuing.</p>
            <% end %>
            <% unless @feedback_attempt.correct? %>
              <% if @feedback_card&.black_box&.any? %>
                <details class="arcade-progress"><summary>Item-specific Black Box guidance</summary>
                  <p><strong>Symptom:</strong> <%= @feedback_card.black_box["symptom"] %></p><p><strong>Expected:</strong> <%= @feedback_card.black_box["expected"] %></p><p><strong>Repair:</strong> <%= @feedback_card.black_box["repair"] %></p><% if @feedback_card.black_box["reasoning_error"].present? %><p><strong>Reasoning error:</strong> <%= @feedback_card.black_box["reasoning_error"] %></p><% end %>
                </details>
              <% end %>
              <%= form_with url: english_arcade_attempts_path(session_id: @arcade_session.id), scope: :english_arcade_attempt, local: true do |form| %>
                <%= form.hidden_field :attempt_id, value: @feedback_attempt.id %>
                <%= form.hidden_field :phase, value: "postmortem" %>
                <%= form.hidden_field :card_key, value: @feedback_attempt.card_key %>
                <fieldset class="arcade-black-box" aria-labelledby="black-box-title">
                  <legend id="black-box-title"><strong>Black Box post-mortem</strong> <small class="arcade-muted">all five fields are required</small></legend>
                  <label for="english-arcade-black-box-root-cause">Actionable root cause
                    <%= form.text_area :black_box_root_cause, id: "english-arcade-black-box-root-cause", rows: 2, class: "arcade-text", required: true, value: @feedback_attempt.black_box_root_cause %>
                  </label>
                  <label for="english-arcade-black-box-missing-signal">Missing mental model / signal
                    <%= form.text_area :black_box_missing_signal, id: "english-arcade-black-box-missing-signal", rows: 2, class: "arcade-text", required: true, value: @feedback_attempt.black_box_missing_signal %>
                  </label>
                  <label for="english-arcade-black-box-preventive-rule">Preventive rule
                    <%= form.text_area :black_box_preventive_rule, id: "english-arcade-black-box-preventive-rule", rows: 2, class: "arcade-text", required: true, value: @feedback_attempt.black_box_preventive_rule %>
                  </label>
                  <label for="english-arcade-black-box-targeted-exercise">Targeted exercise
                    <%= form.text_area :black_box_targeted_exercise, id: "english-arcade-black-box-targeted-exercise", rows: 2, class: "arcade-text", required: true, value: @feedback_attempt.black_box_targeted_exercise %>
                  </label>
                  <label for="english-arcade-black-box-retest-dates">Retest dates
                    <%= form.text_area :black_box_retest_dates, id: "english-arcade-black-box-retest-dates", rows: 2, class: "arcade-text", required: true, value: @feedback_attempt.black_box_retest_dates %>
                  </label>
                  <%= form.submit "Save post-mortem", class: "arcade-button secondary" %>
                </fieldset>
              <% end %>
            <% end %>
          </section>
        <% end %>

        <% if @pending_attempt && @current_card && @arcade_session.active? %>
          <section class="arcade-feedback" aria-labelledby="feynman-title" aria-live="polite">
            <span class="arcade-kicker">Commit recorded · feedback still locked</span>
            <h2 id="feynman-title">Feynman pass before the reveal</h2>
            <p class="arcade-context">Explain why you chose that option in your own words. This is the closed-book reasoning trace; the answer and diagnostic stay server-side until you commit this pass.</p>
            <% if @feynman_dto.present? %>
              <% case @feynman_dto["variant_id"].to_s %>
              <% when "follow_up" %>
                <% if @feynman_dto["instruction"].present? %><p class="arcade-context"><strong>Follow-up Feynman cue:</strong> <%= @feynman_dto["instruction"] %></p><% end %>
              <% when "delayed_variant" %>
                <p class="arcade-context"><strong>Delayed-variant Feynman cue:</strong><% if @feynman_dto["changed_constraint"].present? %> Changed constraint: <%= @feynman_dto["changed_constraint"] %><% end %><% if @feynman_dto["new_evidence"].present? %> New evidence: <%= @feynman_dto["new_evidence"] %><% end %></p>
              <% when "initial" %>
                <p class="arcade-context"><strong>Feynman cue:</strong> Explain <%= @feynman_dto["concept"] %> to <%= @feynman_dto["explain_to"] %>. <%= @feynman_dto["constraint"] %> Self-check: <%= @feynman_dto["self_check"] %><% if @feynman_dto["reasoning_check"].present? %> Reasoning check: <%= @feynman_dto["reasoning_check"] %><% end %></p>
              <% else %>
                <% if @feynman_dto["instruction"].present? %><p class="arcade-context"><strong>Feynman cue:</strong> <%= @feynman_dto["instruction"] %></p><% end %>
              <% end %>
            <% end %>
            <%= form_with url: english_arcade_attempts_path(session_id: @arcade_session.id), scope: :english_arcade_attempt, local: true, data: { action: "submit->english-arcade#submitFeynman" } do |form| %>
              <%= form.hidden_field :attempt_id, value: @pending_attempt.id %>
              <%= form.hidden_field :phase, value: "feynman" %>
              <%= form.hidden_field :card_key, value: @pending_attempt.card_key %>
              <%= form.label :feynman_text, "Write the reasoning" %>
              <%= form.text_area :feynman_text, rows: 5, class: "arcade-text", placeholder: "I chose this because… The trade-off I would verify is…", autofocus: true, required: true, minlength: 40 %>
              <div class="arcade-actions">
                <%= form.submit "Reveal feedback", class: "arcade-button" %>
                <span class="arcade-muted">The reveal grades the committed choice, not the prose.</span>
              </div>
            <% end %>
          </section>
        <% elsif @current_card && @arcade_session.active? && (!@feedback_attempt || @feedback_attempt.correct? || @feedback_attempt.black_box_complete?) %>
          <div>
            <span class="arcade-kicker"><%= @exercise == "initial" ? "Closed-book question" : @exercise.humanize %></span>
            <h2><%= @current_card.prompt %></h2>
            <p class="arcade-context"><%= @current_card.context %><% if @exercise == "rephrase" %> <strong><%= @current_card.rephrase_prompt %></strong><% elsif @exercise == "extension" %> <strong><%= @current_card.extension_prompt %></strong><% elsif @exercise == "compression" %> <strong><%= @current_card.compression_prompt %></strong><% end %></p>
          </div>

          <%= form_with url: english_arcade_attempts_path(session_id: @arcade_session.id), scope: :english_arcade_attempt, local: true, data: { action: "submit->english-arcade#submit", english_arcade_target: "form" } do |form| %>
            <%= form.hidden_field :card_key, value: @current_card.key %>
            <%= form.hidden_field :exercise, value: (@pending_attempt&.attempt_kind || @exercise) %>
            <%= form.hidden_field :parent_attempt_id, value: @pending_attempt&.parent_attempt_id %>
            <%= form.hidden_field :response_ms, value: nil, data: { english_arcade_target: "responseMs" } %>
            <fieldset class="arcade-choice-list">
              <legend class="arcade-muted">Choose the strongest answer before revealing feedback.</legend>
              <% @current_card.options.each_with_index do |choice, index| %>
                <label class="arcade-choice" data-english-arcade-target="choice" data-choice-index="<%= index + 1 %>">
                  <%= form.radio_button :answer_choice, choice.id, required: true %>
                  <span class="choice-key"><%= (index + 1).to_s %></span>
                  <span><%= choice.text %></span>
                </label>
              <% end %>
            </fieldset>

            <div class="arcade-capture">
              <label>
                <span><strong>Typed answer</strong> <small class="arcade-muted">required; at least 40 characters before feedback</small></span>
                <%= form.text_area :typed_answer, rows: 4, class: "arcade-text", required: true, minlength: 40, placeholder: "State your decision, caveat, evidence, and next step…", data: { english_arcade_target: "typed" } %>
              </label>
            </div>
            <fieldset class="arcade-critical" aria-labelledby="critical-thinking-title">
              <legend id="critical-thinking-title"><strong><%= @exercise == "follow_up" ? "Follow-up critical-thinking ledger" : "Critical-thinking ledger" %></strong> <small class="arcade-muted">captured before feedback; label evidence, do not fact-check yourself</small></legend>
              <label for="english-arcade-evidence-verified">Verified fact(s)
                <%= form.text_area :evidence_verified, id: "english-arcade-evidence-verified", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "What does the prompt, code, or source actually establish?" %>
              </label>
              <label for="english-arcade-problem-frame">Problem frame
                <%= form.text_area :problem_frame, id: "english-arcade-problem-frame", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "Who is affected, what must succeed, which constraint matters, and what remains unknown?" %>
              </label>
              <label for="english-arcade-evidence-inference">Inference(s)
                <%= form.text_area :evidence_inference, id: "english-arcade-evidence-inference", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "What are you inferring, and why?" %>
              </label>
              <label for="english-arcade-evidence-assumption">Assumption(s)
                <%= form.text_area :evidence_assumption, id: "english-arcade-evidence-assumption", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "Which premise still needs confirmation?" %>
              </label>
              <label for="english-arcade-evidence-gap">Unknown or evidence gap
                <%= form.text_area :evidence_gap, id: "english-arcade-evidence-gap", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "What do you not know yet?" %>
              </label>
              <label for="english-arcade-source-quality">Evidence/source quality
                <%= form.text_area :source_quality, id: "english-arcade-source-quality", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "What is the source, how strong is it, and what limitation remains?" %>
              </label>
              <details class="arcade-progress">
                <summary>Real trade-off branch (use only when A and B satisfy the same contract)</summary>
                <label for="english-arcade-comparison-option-a">Option A
                  <%= form.text_area :comparison_option_a, id: "english-arcade-comparison-option-a", rows: 2, class: "arcade-text" %>
                </label>
                <label for="english-arcade-comparison-option-b">Option B
                  <%= form.text_area :comparison_option_b, id: "english-arcade-comparison-option-b", rows: 2, class: "arcade-text" %>
                </label>
                <label for="english-arcade-comparison-tradeoff">Trade-off
                  <%= form.text_area :comparison_tradeoff, id: "english-arcade-comparison-tradeoff", rows: 2, class: "arcade-text" %>
                </label>
                <label for="english-arcade-comparison-switch-condition">Decision/switch condition
                  <%= form.text_area :comparison_switch_condition, id: "english-arcade-comparison-switch-condition", rows: 2, class: "arcade-text" %>
                </label>
              </details>
              <details class="arcade-progress">
                <summary>False-equivalence branch (when a comparison would hide a hard constraint)</summary>
                <label for="english-arcade-comparison-rejected-alternative">Rejected alternative
                  <%= form.text_area :comparison_rejected_alternative, id: "english-arcade-comparison-rejected-alternative", rows: 2, class: "arcade-text" %>
                </label>
                <label for="english-arcade-comparison-hard-constraint">Hard constraint
                  <%= form.text_area :comparison_hard_constraint, id: "english-arcade-comparison-hard-constraint", rows: 2, class: "arcade-text" %>
                </label>
                <label for="english-arcade-comparison-decision-rule">Clarification/decision rule
                  <%= form.text_area :comparison_decision_rule, id: "english-arcade-comparison-decision-rule", rows: 2, class: "arcade-text" %>
                </label>
              </details>
              <label for="english-arcade-counterexample">Counterexample or failure mode
                <%= form.text_area :counterexample, id: "english-arcade-counterexample", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present?, placeholder: "What could break the recommendation?" %>
              </label>
              <label for="english-arcade-change-my-mind">What would change my mind?
                <%= form.text_area :change_my_mind, id: "english-arcade-change-my-mind", rows: 2, class: "arcade-text", required: @current_card.critical_thinking.present? %>
              </label>
              <label for="english-arcade-confidence-percent">Confidence before reveal (0–100)
                <%= form.number_field :confidence_percent, id: "english-arcade-confidence-percent", min: 0, max: 100, required: @current_card.critical_thinking.present?, inputmode: "numeric" %>
              </label>
            </fieldset>
            <fieldset class="arcade-choice-list">
              <legend class="arcade-muted">Self-assessed evidence (optional, 0–4; report-only and does not grade spoken English)</legend>
              <label>Answer without translation <%= form.select :english_directness, [["English directly", "english_direct"], ["Mixed language", "mixed"], ["Translated first", "translated"]], { prompt: "Choose one" } %></label>
              <% { clarity: "Clarity", precision: "Precision", naturalness: "Naturalness", pragmatic_appropriateness: "Pragmatic appropriateness", technical_correctness: "Technical correctness" }.each do |axis, label| %>
                <label><%= label %> <%= form.select "self_#{axis}", (0..4).map { |value| [value, value] }, { prompt: "Choose 0–4" } %></label>
              <% end %>
            </fieldset>

            <div class="arcade-actions">
              <%= form.submit "Commit answer", class: "arcade-button", data: { english_arcade_target: "submit" } %>
              <%= form.button "Skip and open Black Box", type: "submit", name: "english_arcade_attempt[answer_status]", value: "skip", formnovalidate: true, class: "arcade-button ghost", data: { skip: "true", english_arcade_target: "submit" } %>
              <span class="arcade-muted">Keys 1–4 choose · Enter commits · Escape focuses the answer</span>
            </div>
          <% end %>
        <% elsif @arcade_session.completed? || @arcade_session.expired? %>
          <div class="arcade-feedback"><strong>Session closed.</strong><p>Start another drill to keep the loop moving, or review the history panel for your diagnostic trail.</p></div>
        <% else %>
          <div class="arcade-feedback"><strong>No cards are available yet.</strong><p>Start another session after the content handoff supplies its target pack.</p></div>
        <% end %>
      </div>

      <aside class="arcade-panel" aria-labelledby="arcade-history-title">
        <h2 id="arcade-history-title">Learning loop</h2>
        <p class="arcade-muted">Wrong → box 1 (daily). Correct answers climb through 2d, 4d, weekly, and 2-weekly intervals.</p>
        <div class="arcade-stats">
          <span class="arcade-pill"><%= @schedule_summary[:due] %> due now</span>
          <span class="arcade-pill"><%= @schedule_summary[:learning] %> learning</span>
          <span class="arcade-pill"><%= @schedule_summary[:mastered] %> box 5</span>
        </div>
        <h3>30-day diagnostic</h3>
        <p class="arcade-muted">Program day <%= @progress_30_days[:program_day] %> · <%= @progress_30_days[:practice_days] %> practice days · <%= @progress_30_days[:attempts] %> attempts · <%= @progress_30_days[:correct] %> revealed correct · <%= @progress_30_days[:black_box] %> completed Black Box post-mortems across <%= @progress_30_days[:targets] %> targets.</p>
        <details class="arcade-progress">
          <summary>Evidence axes (practice only)</summary>
          <div class="arcade-evidence">
            <span>Typed captures: <strong><%= @progress_30_days.fetch(:capture_evidence).fetch("typed_count") %></strong></span>
            <span>Meaningful typed answers: <strong><%= @progress_30_days.fetch(:capture_evidence).fetch("meaningful_typed_count") %></strong></span>
            <span>Response-time samples: <strong><%= @progress_30_days.fetch(:response_time_evidence).fetch("count") %></strong></span>
            <span>Average response: <strong><%= @progress_30_days.fetch(:response_time_evidence).fetch("average_ms") || "—" %> ms</strong></span>
          </div>
          <p class="arcade-muted"><strong>Feedback evidence:</strong> <%= @progress_30_days.fetch(:feedback_evidence).map { |axis, evidence| "#{axis} #{evidence.fetch("observations")}" }.join(" · ") %></p>
          <p class="arcade-muted"><strong>Direct thinking (self-reported):</strong> <%= @progress_30_days.dig(:direct_thinking, "direct") %>/<%= @progress_30_days.dig(:direct_thinking, "eligible") %> · <%= @progress_30_days.dig(:direct_thinking, "rate") || "—" %>.</p>
          <p class="arcade-muted"><strong>Self-rubric (self-assessed):</strong> <%= @progress_30_days.fetch(:self_rubric).map { |axis, evidence| "#{axis} #{evidence.fetch("average") || "—"}/4 (#{evidence.fetch("count")})" }.join(" · ") %></p>
          <p class="arcade-muted"><strong>Baseline:</strong> <%= @progress_30_days.dig(:baseline, "status") %>. Technical knowledge and general C2-calibrated performance remain separate evidence sets.</p>
          <p class="arcade-muted"><strong>Delayed retention events:</strong> <%= @progress_30_days.dig(:delayed_retention, "successful_events") %>/<%= @progress_30_days.dig(:delayed_retention, "eligible_events") %> successful retests at least 7 days later · distinct cards: <%= @progress_30_days.dig(:delayed_retention, "successful_cards") %>/<%= @progress_30_days.dig(:delayed_retention, "eligible_cards") %> · follow-up adaptations: <%= @progress_30_days.dig(:follow_up_adaptation, "follow_up_completed") %>/<%= @progress_30_days.dig(:follow_up_adaptation, "eligible") %> · all adaptation kinds: <%= @progress_30_days.dig(:follow_up_adaptation, "adaptation_completed") %>/<%= @progress_30_days.dig(:follow_up_adaptation, "eligible") %>.</p>
          <p class="arcade-muted"><strong>Target accuracy:</strong> <%= @progress_30_days.fetch(:target_accuracy).map { |target, evidence| "#{target.humanize} #{evidence.fetch("accuracy") || "—"}" }.join(" · ") %></p>
          <p class="arcade-muted"><strong>Language skills:</strong> <%= @progress_30_days.fetch(:skill_evidence).map { |skill, evidence| "#{skill.humanize}: #{evidence.fetch("status")}" }.join(" · ") %></p>
          <p class="arcade-muted"><%= @progress_30_days.fetch(:score_note) %></p>
        </details>
        <div class="arcade-actions">
          <%= button_to "Finish and save session", finish_english_arcade_path(session_id: @arcade_session.id), method: :post, class: "arcade-button secondary" if @arcade_session.active? %>
        </div>
        <h3>Recent attempts</h3>
        <div class="arcade-history">
          <% if @history.any? %>
            <% @history.each do |attempt| %>
              <article>
                <strong><%= attempt.target.humanize %> · <%= attempt.attempt_kind.humanize %></strong>
                <% history_status = attempt.feedback_revealed? ? (attempt.correct? ? "Correct" : "Needs another pass") : "Feedback locked" %>
                <p class="arcade-muted"><%= history_status %> · box <%= attempt.box_before %> → <%= attempt.box_after %> · <%= attempt.answered_at.to_fs(:short) %></p>
              </article>
            <% end %>
          <% else %>
            <p class="arcade-muted">No attempts yet. Your first answer establishes the baseline.</p>
          <% end %>
        </div>
      </aside>
    </div>
    <% end %>
  <% end %>
</section>
