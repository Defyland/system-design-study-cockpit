<% content_for :title, "Pergunta do quiz · Cockpit" %>
<section class="study-page"><div class="study-meta"><%= link_to "← Quiz", study_quizzes_path %><span><%= @round.mode == "errors" ? "REVISÃO DE ERROS" : "QUIZ INÉDITO" %></span></div>
  <div class="study-grid"><div class="study-panel study-main-panel"><p class="study-eyebrow">PERGUNTA <%= @round.position + 1 %> DE <%= @round.card_keys.size %></p><progress value="<%= @round.position %>" max="<%= @round.card_keys.size %>" aria-label="Progresso do quiz"></progress>
    <% if @round.finished? %><h1>Quiz concluído.</h1><p>Suas respostas ficaram salvas. Os erros só voltam quando você pedir na revisão.</p><%= link_to "Ver revisão", study_review_path, class: "study-resume" %>
    <% elsif @card %><article class="study-question"><p class="study-eyebrow"><%= @card[:source] %></p><h1><%= @card[:prompt] %></h1><% if @card[:context].present? %><p><%= @card[:context] %></p><% end %>
      <% if @response %><div class="study-feedback <%= @response['correct'] ? 'study-correct' : 'study-wrong' %>" role="status"><h2><%= @response["correct"] ? "Sua resposta está correta" : "Revise esta resposta" %></h2>
          <% selected = @choices.find { |choice| choice["id"] == @response["choice_id"] } %><% correct = @choices.find { |choice| choice["correct"] } %>
          <p><strong>◉ Sua resposta:</strong> <%= selected && selected["text"] %></p><p><strong>✓ Resposta canônica:</strong> <%= correct && correct["text"] %></p>
          <% if selected && !selected["correct"] %><p><strong>Por que falha:</strong> <%= selected["why_wrong"] %></p><% end %>
        </div><div class="study-quiz-footer"><%= button_to "Próxima pergunta →", study_quiz_path(@round), method: :patch, params: { position: @round.position, card_key: @card[:id], direction: "next" } %><% if @source_documents&.any? %><%= link_to "Rever conceito", study_card_source_path(@source_documents.first), class: "study-secondary" %><% end %></div>
      <% else %><%= form_with url: study_quiz_path(@round), method: :patch, class: "study-quiz-form", data: { controller: "quiz-answer", action: "submit->quiz-answer#submitting turbo:fetch-request-error->quiz-answer#failed" } do %><%= hidden_field_tag :position, @round.position %><%= hidden_field_tag :card_key, @card[:id] %><%= hidden_field_tag :direction, "answer" %>
        <fieldset><legend>Escolha uma resposta</legend><% @choices.each do |choice| %><label class="study-choice"><%= radio_button_tag :choice_id, choice["id"], false, required: true, data: { action: "change->quiz-answer#selected" } %><span><%= choice["text"] %></span></label><% end %></fieldset><div class="study-quiz-footer"><button data-quiz-answer-target="button" disabled>Conferir resposta</button><p class="study-muted">Sua resposta será registrada.</p><p class="study-save-error" data-quiz-answer-target="error" role="alert" hidden>Não foi possível salvar. A escolha permanece nesta tela; tente novamente.</p></div><% end %><% end %>
        <% if @source_documents&.any? %><%= link_to "Abrir fonte original", study_card_source_path(@source_documents.first), class: "study-citation study-mobile-only" %><% end %>
      </article>
    <% else %><h1>Pergunta indisponível</h1><p>O item original do Arcade não está disponível. Sua tentativa permanece salva; volte ao quiz para iniciar com conteúdo elegível.</p><% end %>
  </div><aside class="study-panel study-side-panel"><h2>Fonte</h2><% if @card %><p><%= @card[:source] %></p><% if @source_documents&.any? %><ul><% @source_documents.each do |document| %><li><%= link_to document.title, study_card_source_path(document) %></li><% end %></ul><% end %><% sources = @card.dig(:coaching, "sources") %><% if sources.present? %><details><summary>Referências do item</summary><%= study_coaching(sources) %></details><% end %><% end %><p class="study-muted">Resultado de avaliação separado do progresso de leitura.</p></aside></div>
</section>
