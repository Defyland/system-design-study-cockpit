<% content_for :title, "Mapa do acervo · Cockpit" %>
<section class="study-page" data-controller="study-map">
  <div class="study-meta"><%= link_to "← Biblioteca", study_cards_path(topic: @selected_topic, source_ids: @source_ids) %><span>MAPA DO ACERVO</span></div>
  <div class="study-page-heading"><h1>Mapa do acervo</h1><p>Trilhas, documentos e seções do acervo. As conexões abaixo representam apenas esta hierarquia.</p></div>
  <div class="study-panel">
    <%= form_with url: study_map_path, method: :get, class: "study-filter" do |form| %><% @source_ids.each do |id| %><%= hidden_field_tag "source_ids[]", id %><% end %><%= form.label :topic, "Trilha" %><%= form.select :topic, @topics.map { |key, label| [label, key] }, selected: @selected_topic %><%= form.submit "Mostrar", class: "study-secondary" %><% end %>
    <p class="study-muted"><%= @documents.size %> <%= @documents.size == 1 ? "documento" : "documentos" %> nesta trilha. Expanda um documento, abra uma seção ou inicie uma rodada filtrada.</p>
    <div class="study-map-controls"><button type="button" class="study-secondary" data-action="click->study-map#map" data-study-map-target="mapButton">Mapa</button><button type="button" class="study-secondary" data-action="click->study-map#list" data-study-map-target="listButton">Lista</button><span data-study-map-target="zoomControls"><button type="button" class="study-secondary" data-action="click->study-map#zoomOut" aria-label="Reduzir mapa">−</button><button type="button" class="study-secondary" data-action="click->study-map#zoomIn" aria-label="Ampliar mapa">+</button><button type="button" class="study-secondary" data-action="click->study-map#fit">Enquadrar</button></span></div>
    <% if @documents.empty? %><p class="study-empty">Nenhum documento nesta trilha. Escolha outra para explorar.</p><% end %>
    <div class="study-map-canvas" data-study-map-target="canvas" hidden><div class="study-map-transform" data-study-map-target="transform">
      <div class="study-map-root"><%= @topics.fetch(@selected_topic) %></div>
      <div class="study-map-branches"><% @documents.take(24).each do |document, sections| %><section class="study-map-branch"><h2><%= document.title %></h2><%= link_to "Documento original", study_card_source_path(document) %><ul><% sections.each do |section| %><li><%= link_to section[:prompt], study_map_path(topic: @selected_topic, source_ids: @source_ids, document_id: document.id, section: section[:id], anchor: "study-map-preview") %></li><% end %></ul></section><% end %></div>
      <% if @documents.size > 24 %><p class="study-muted">Mostrando 24 documentos no mapa. Filtre a trilha ou use a lista para acessar todos os <%= @documents.size %>.</p><% end %>
    </div></div>
    <div data-study-map-target="list"><ul class="study-map-list"><% @documents.each do |document, sections| %><li><details><summary><strong><%= document.title %></strong> · <%= sections.size %> seções</summary><div class="study-map-actions"><%= link_to "Abrir documento", study_card_source_path(document) %><%= button_to "Estudar este documento", study_cards_path, params: { topic: @selected_topic, source_ids: [document.id], mode: "new" } %></div><ul><% sections.each do |section| %><li><%= link_to section[:prompt], study_map_path(topic: @selected_topic, source_ids: @source_ids, document_id: document.id, section: section[:id], anchor: "study-map-preview") %> <%= link_to "Fonte original", study_section_path(section), class: "study-source-link" %></li><% end %></ul></details></li><% end %></ul></div>
    <% if @selected_section %><article id="study-map-preview" class="study-map-preview" aria-label="Trecho selecionado"><p class="study-eyebrow">TRECHO DO ACERVO SELECIONADO</p><h2><%= @selected_section[:prompt] %></h2><p><%= @selected_document.title %></p><div class="study-original"><%= study_card_markdown(@selected_section[:answer_markdown], source_path: @selected_document.source_path) %></div><div class="study-actions"><%= link_to "Abrir fonte", study_section_path(@selected_section), class: "study-citation" %><%= button_to "Estudar este assunto", study_cards_path, params: { topic: @selected_topic, source_ids: [@selected_document.id], mode: "new" } %></div></article>
    <% elsif params[:section].present? %><p class="study-empty">Trecho indisponível. Selecione outra seção existente.</p><% end %>
  </div>
</section>
