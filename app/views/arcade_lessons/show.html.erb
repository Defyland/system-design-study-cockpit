<% content_for :title, "Lesson · Arena" %>
<% lesson_mode = @lesson_payload.fetch("target_mode", "").to_s %>
<% interview_role = @lesson_payload["interview_role"].to_s.presence %>
<% role_metadata = EnglishArcadeResumeInterviewProfile.role_metadata %>
<% interview_role_label = role_metadata.fetch(interview_role).fetch(:label) if interview_role.present? %>
<section class="arena-shell arena-lesson" data-controller="arcade-lesson" data-arcade-lesson-id-value="<%= @lesson_payload.fetch("id") %>" data-arcade-lesson-result-url-value="<%= @lesson_payload.dig("urls", "result") %>" data-arcade-lesson-finish-url-value="<%= @lesson_payload.dig("urls", "finish") %>" data-arcade-lesson-companion-base-url-value="<%= @companion_base_url %>">
  <header class="arena-lesson-header">
    <div class="arena-lesson-brand"><%= link_to "Arena", arena_path, class: "arena-wordmark" %><span class="arena-slash">/</span><span>Lesson</span></div>
    <div class="arena-lesson-context" aria-label="Lesson context">
      <% if lesson_mode == "interview" %>
        <span class="arena-lesson-context-label">Interview rehearsal</span>
        <% if interview_role %><span class="arena-lesson-role"><%= interview_role_label %> lens</span><% end %>
      <% else %>
        <span class="arena-lesson-context-label">English practice</span>
      <% end %>
    </div>
    <div class="arena-lesson-controls"><button type="button" class="arena-icon-button" data-action="arcade-lesson#pause" aria-label="Pause lesson">Pause <kbd>Space</kbd></button><button type="button" class="arena-icon-button arena-icon-button-secondary" data-arcade-lesson-target="audioToggle" data-action="arcade-lesson#toggleSound" aria-pressed="false">Sound off</button><button type="button" class="arena-icon-button arena-icon-button-secondary" data-action="arcade-lesson#openDossier">Dossier <kbd>D</kbd></button><button type="button" class="arena-icon-button arena-icon-button-secondary" data-action="arcade-lesson#openHelp">Help <kbd>?</kbd></button></div>
  </header>

  <section class="arena-hud" aria-label="Lesson progress">
    <div class="arena-hud-heading">
      <div><p class="arena-eyebrow">Learning route</p><strong>Learn → Recall → Transfer</strong></div>
      <span><strong data-arcade-lesson-target="position">1</strong> / <%= @lesson_payload.dig("totals", "total") %></span>
    </div>
    <div class="arena-progress-track" aria-hidden="true"><i data-arcade-lesson-target="progress"></i></div>
    <div class="arena-hud-meta"><span class="arena-stage-badge" data-arcade-lesson-target="stage">Meet</span><span class="arena-target-badge" data-arcade-lesson-target="target">Mixed</span><span class="arena-combo" data-arcade-lesson-target="combo">Combo 0</span></div>
  </section>

  <main class="arena-exercise-wrap">
    <div class="arena-lesson-layout">
      <div class="arena-exercise-column">
        <div class="arena-exercise" data-arcade-lesson-target="exercise"></div>
        <section class="arena-feedback" data-arcade-lesson-target="feedback" hidden aria-live="assertive"></section>
        <section class="arena-results" data-arcade-lesson-target="results" tabindex="-1" hidden></section>
      </div>
      <details class="arena-lesson-guide">
        <summary id="lesson-guide-title">Answer guide</summary>
        <div class="arena-lesson-guide-content">
          <p class="arena-eyebrow">Three useful moves</p>
        <ol class="arena-guide-steps">
          <li><span>01</span><div><strong>Read the situation</strong><small>What do I know, what am I assuming, and which question would resolve my uncertainty?</small></div></li>
          <li><span>02</span><div><strong>Answer from memory</strong><small>Answer the question or identify the requested distinction. Add a reason, cost, or condition when it helps explain that answer.</small></div></li>
          <li><span>03</span><div><strong>Use the feedback</strong><small>Which part of my explanation needs evidence or correction? Revise it, then test the decision against the next variation.</small></div></li>
        </ol>
        </div>
      </details>
    </div>
  </main>

  <footer class="arena-key-help"><span><kbd>1</kbd>–<kbd>6</kbd> choose when shown</span><span><kbd>Tab</kbd>/<kbd>Enter</kbd> use focused controls</span><span><kbd>Enter</kbd> continues feedback</span><span><kbd>Space</kbd> pause</span><span><kbd>D</kbd> dossier</span></footer>

  <dialog class="arena-dialog" data-arcade-lesson-target="exitDialog" aria-labelledby="arena-exit-title">
    <h2 id="arena-exit-title">Leave this lesson?</h2><p>Your recorded stages remain saved. You can return from the Arena hub.</p><div class="arena-dialog-actions"><button type="button" class="arena-button arena-button-quiet" data-action="arcade-lesson#closeDialog">Keep going</button><%= link_to "Exit to hub", arena_path, class: "arena-button" %></div>
  </dialog>
  <dialog class="arena-dialog" data-arcade-lesson-target="dossierDialog" aria-labelledby="arena-dossier-title">
    <h2 id="arena-dossier-title">Today's dossier</h2><div data-arcade-lesson-target="dossierCopy"><p>Reference notes appear after an exercise is answered. The Arena does not preload answer keys.</p></div><button type="button" class="arena-button arena-button-quiet" data-action="arcade-lesson#closeDossier">Close <kbd>Esc</kbd></button>
  </dialog>
  <dialog class="arena-dialog" data-arcade-lesson-target="helpDialog" aria-labelledby="arena-help-title">
    <h2 id="arena-help-title">Keyboard help</h2><p><kbd>1</kbd>–<kbd>6</kbd> choose when a numbered option is shown; <kbd>Tab</kbd> moves through chips, chunks, and form controls; <kbd>Enter</kbd> activates focused buttons or continues after feedback. In free text, use the visible submit button. <kbd>Space</kbd> pauses when a control is not focused; <kbd>D</kbd> opens the dossier; <kbd>Esc</kbd> opens the exit dialog.</p><button type="button" class="arena-button arena-button-quiet" data-action="arcade-lesson#closeHelp">Close</button>
  </dialog>

  <script id="arcade-lesson-data" type="application/json"><%= raw json_escape(@lesson_payload.to_json) %></script>
</section>
