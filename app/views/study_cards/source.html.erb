<% content_for :title, "#{@document.title} · Acervo" %>
<section class="study-page study-source-document">
  <div class="study-meta"><%= link_to "← Biblioteca", study_cards_path %><span>DOCUMENTO ORIGINAL DO ACERVO</span></div>
  <article class="study-panel study-document-body"><h1><%= @document.title %></h1>
    <% StudyDocumentCards.new(documents: [@document]).cards.each do |section| %>
      <section id="section-<%= section[:id] %>" class="study-original-section" tabindex="-1"><%= study_card_markdown(section[:answer_markdown], source_path: @document.source_path) %></section>
    <% end %>
  </article>
</section>
